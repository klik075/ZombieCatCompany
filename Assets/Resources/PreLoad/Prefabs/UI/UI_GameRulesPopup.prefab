  m_text: "\uC774 \uAC8C\uC784\uC740 \uC880\uBE44 \uACE0\uC591\uC774\uAC00 \uC815\uCCB4\uB97C
    \uC228\uAE34 \uCC44 \uAC8C\uC784 \uD68C\uC0AC\uB97C \uC6B4\uC601\uD558\uBA70
    \uC0B4\uC544\uB0A8\uB294 \uC11C\uBC14\uC774\uBC8C, \uC804\uB7B5, \uB514\uD39C\uC2A4,
    \uACBD\uC601 \uC2DC\uBBAC\uB808\uC774\uC158 \uAC8C\uC784\uC785\uB2C8\uB2E4. \n\uBC24\uC5D0\uB294
    \uAC8C\uC784\uC744 \uAC1C\uBC1C\uD574 \uB3C8\uC744 \uBC8C\uACE0, \uB0AE\uC5D0\uB294
    \uAC8C\uC784\uC5D0 \uBD88\uB9CC\uC744 \uAC00\uC9C4 \uC720\uC800 \uACE0\uC591\uC774\uB4E4\uC758
    \uC2DC\uC704\uB97C \uB9C9\uC544\uC57C \uD569\uB2C8\uB2E4.\n\uC2DD\uB7C9\uC744
    \uAD00\uB9AC\uD558\uACE0 \uB05D\uAE4C\uC9C0 \uC0B4\uC544\uB0A8\uC544 \uC880\uBE44
    \uBC14\uC774\uB7EC\uC2A4\uB97C \uCE58\uB8CC\uD560 \uBC29\uBC95\uC744 \uCC3E\uC544\uBCF4\uC138\uC694."
