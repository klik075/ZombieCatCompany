.gamehud-panel {
    width: 100%;
    height: 100%;
    position: absolute;
    bottom: 0;
    left: 0;
    flex-direction: column;
    justify-content: flex-end;
}

.button-row {
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
    margin-bottom: 32px;
    gap: 24px;
}

.gamehud-button {
    width: 120px;
    height: 48px;
    font-size: 18px;
    background-color: #4CAF50;
    color: white;
    border-radius: 8px;
}